generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL DEV: SQLite (file:./prisma/dev.db in .env.local)
  // VERCEL:    The build script replaces "sqlite" with "postgresql" and adds a directUrl
  //            line automatically — see scripts/vercel-build.js
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessUnit {
  id         String   @id @default(cuid())
  name       String   @unique
  budget     Float    @default(0)   // fallback if no year-specific config
  staffCount Int      @default(0)   // fallback if no year-specific config
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Single-row global settings — currently just the subscription/budget toggle
model BudgetSettings {
  id                         String   @id @default(cuid())
  countSubscriptionsInBudget Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

// Single-row config for the live Google Sheets data source. The service account credentials
// themselves live in environment variables (never in the DB) — this just tracks which
// spreadsheet/tabs to read and the sync schedule, plus the outcome of the last sync attempt.
model GoogleSheetsConfig {
  id                               String    @id @default(cuid())
  spreadsheetUrl                   String?
  trainingSheetName                String    @default("Training Cost")
  feedbackSheetName                String    @default("Feedback")
  subscriptionSheetName            String    @default("Subscriptions")
  kssSheetName                     String    @default("KSS")
  rosterSheetName                  String? // optional — when set, Sync Now/scheduled sync also imports new-or-changed Staff Roster rows from this tab, same as a manual Upload & Data → Staff Roster upload. Leave blank to keep managing the roster by upload only.
  comprehensiveStaffListSheetName  String? // optional secondary staff source (e.g. "MERISTEM COMPREHENSIVE STAFF LIST") — read-only supplement to the uploaded roster, fills in gaps like missing email/line manager
  talentMemberSheetName            String? // tab the Talent Member roster (TalentMemberRosterEntry) is mirrored into — admin adds/removes TMs from the Talent Members page, not by editing this sheet directly
  autoSyncEnabled                  Boolean   @default(false)
  syncFrequencyMinutes             Int       @default(60)
  lastSyncedAt                     DateTime?
  lastSyncStatus                   String? // "success" | "error"
  lastSyncErrors                   String? // JSON: { sheet: string, message: string }[]
  updatedAt                        DateTime  @updatedAt
}

// One row per completed sync run (manual "Sync Now" or scheduled) — only the 5 most recent are
// kept. batchIds records which UploadBatch rows this run created, so "Undo" can delete exactly
// those (cascading to their records) without touching anything from other syncs or uploads.
model GoogleSheetsSyncLog {
  id        String   @id @default(cuid())
  syncedAt  DateTime @default(now())
  trigger   String // "manual" | "scheduled"
  success   Boolean
  imported  String // JSON: { training?: number, feedback?: number, subscription?: number, kss?: number }
  errors    String // JSON: { sheet: string, message: string }[]
  batchIds  String // JSON array of UploadBatch ids created by this run
  undone    Boolean  @default(false)
  undoneAt  DateTime?
}

// Login identity is Staff ID and/or email — at least one must be set.
// Default password (set at creation) is the user's own Staff ID (or email if no Staff ID) —
// they can change it later from Account Settings. Admin can toggle requiresPassword off per
// user for a passwordless (identifier-only) login.
model User {
  id                String   @id @default(cuid())
  staffId           String?  @unique
  email             String?  @unique
  name              String
  passwordHash      String?
  requiresPassword  Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  isSuperAdmin      Boolean  @default(false)
  businessUnitScope String   @default("ALL") // "ALL" or one BusinessUnit.name
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permissions UserPagePermission[]

  @@index([staffId])
  @@index([email])
}

// Per-page permission level for a user. Ignored entirely for isSuperAdmin users (full access).
model UserPagePermission {
  id     String @id @default(cuid())
  userId String
  page   String // 'executive-overview' | 'training-analytics' | 'subscriptions' | 'business-units' | 'capability-coverage' | 'yet-to-attend' | 'talent-members' | 'report-generation' | 'upload-data' | 'admin-settings'
  level  String // 'view' | 'view-export' | 'admin'

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page])
}

// Training Type taxonomy — classifies training spend as "formal" (Internal/External Training)
// or "other" (Summit, Leadership Cafe, Workshop, etc. — the "Strategic Learning Initiatives" bucket)
model TrainingType {
  id             String   @id @default(cuid())
  name           String   @unique
  classification String   // "formal" | "other"
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Differentiating Capability taxonomy — tags training records for coverage reporting
model DifferentiatingCapability {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The Talent Member (TM) roster itself — admin-entered from the Talent Members page (bulk paste
// or one at a time, by name/Staff ID/email), NOT derived from a column on the general staff list.
// Each entry is mirrored (best-effort, auto + manual retry) into the sheet tab configured as
// GoogleSheetsConfig.talentMemberSheetName, so the admin has an external copy too.
model TalentMemberRosterEntry {
  id             String    @id @default(cuid())
  staffId        String?
  name           String?
  email          String?
  createdAt      DateTime  @default(now())
  sheetSyncedAt  DateTime?
  sheetSyncError String?

  @@index([staffId])
}

// Per-year exemption list for the Talent Member (TM) Trainings report — staff the admin has
// excused from that year's TM completion requirement. Entered by whichever identifier the admin
// has on hand (name, Staff ID, or email); resolved against the live TM roster (StaffRosterRecord
// + comprehensive staff list "Is Talent Member" column) at read time, not stored redundantly.
model TalentMemberExemption {
  id        String   @id @default(cuid())
  year      Int
  staffId   String?
  name      String?
  email     String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([year])
}

// Durable record of every individual survey send attempt (original send or reminder nudge) —
// attendee.*SurveySentAt only ever holds the LATEST send time, so a resend silently erases any
// trace that an earlier send happened. This is the audit trail: who was emailed, when, for which
// schedule/stage, whether it was a reminder, and whether it actually succeeded.
model SurveySendLog {
  id           String   @id @default(cuid())
  scheduleId   String
  trainingName String // denormalized — readable even after the schedule itself is deleted
  stage        String // "pre" | "post1" | "post2"
  attendeeId   String
  staffName    String
  recipient    String // the actual "to" address used (employee or manager, per stage)
  isReminder   Boolean  @default(false)
  success      Boolean
  errorMessage String?
  sentAt       DateTime @default(now())

  @@index([scheduleId])
  @@index([sentAt])
}

// Admin-managed vendor/facilitator list — lets Training Schedule entries pick a vendor from a
// fixed list rather than free text, so the TM Trainings report can show a real (not guessed)
// vendor per training.
model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit trail for "Other Investment Budget" group-cost distributions — lets the admin see what's
// already been applied (and to which training) before applying another, and flags likely duplicates.
model GroupCostDistribution {
  id          String   @id @default(cuid())
  training    String
  totalAmount Float
  breakdown   String   // JSON: { businessUnit, attendeeCount, share, perPersonAmount }[]
  appliedAt   DateTime @default(now())

  @@index([training])
}

// Year-specific budget and headcount per BU
model BusinessUnitYearConfig {
  id         String   @id @default(cuid())
  buName     String
  year       Int
  budget     Float    @default(0)
  staffCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([buName, year])
  @@index([year])
}

model UploadBatch {
  id          String   @id @default(cuid())
  type        String   // "training" | "feedback" | "subscription" | "kss"
  filename    String
  recordCount Int
  period      String?
  createdAt   DateTime @default(now())

  trainingRecords      TrainingRecord[]
  feedbackRecords      FeedbackRecord[]
  subscriptionRecords  SubscriptionRecord[]
  kssRecords           KSSRecord[]
  staffRosterRecords   StaffRosterRecord[]
  managerReviewRecords ManagerReviewRecord[]
}

// Line-manager post-training reviews — a second, independent impact rating (0-5, same scale
// as FeedbackRecord.confidenceRating) assessed by the manager rather than self-reported by the
// trainee. Surfaced on Slide 2 of the Executive Overview and per-BU reports alongside the
// existing confidence rating, but computed and stored separately from FeedbackRecord.
model ManagerReviewRecord {
  id           String   @id @default(cuid())
  staffId      String
  staffName    String
  businessUnit String
  training     String
  managerName  String?
  impactScore  Float // 0–5
  comments     String?
  month        String?
  batchId      String
  createdAt    DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
  @@index([staffId])
}

// Staff roster snapshot — used only by the "Yet to Attend Training" report (compares the
// confirmed roster against TrainingRecord attendance). Does not feed any other report.
// Multiple uploads accumulate; the report always uses each staffId's most recent record.
model StaffRosterRecord {
  id                String    @id @default(cuid())
  staffId           String
  firstName         String
  middleName        String?
  lastName          String
  email             String? // second unique key alongside staffId — also used for survey CC lookups
  lineManagerStaffId String? // references another StaffRosterRecord.staffId — plain string, not an FK (same pattern as businessUnit)
  businessUnit      String
  role              String?
  department        String?
  employmentType    String? // "Full-Time" | "Part-Time" | "Intern" | "Contract" — set via the Employees page, not part of the original Excel upload columns
  active            Boolean   @default(true) // toggled via "Deactivate"/"Reactivate" on the Employees page — a leaver is deactivated, not deleted, so historical training/analytics referencing them stays intact
  employmentDate    DateTime?
  confirmed         Boolean   @default(true)
  batchId           String
  createdAt         DateTime  @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
  @@index([staffId])
  @@index([email])
}

// Survey automation — single-row settings: the 3 Google Form links and sender display name.
// SMTP credentials themselves live in environment variables, never here.
// Forms are native to the platform (no Google Forms involved) — a submission writes to the
// database and, if a tab name is set below, also appends a mirror row to that tab in the same
// spreadsheet already configured under Live Data Source (GoogleSheetsConfig.spreadsheetUrl).
// Mirroring is optional per stage — leave a tab name blank to skip it for that stage.
model SurveySettings {
  id                    String   @id @default(cuid())
  post1MirrorSheetName  String?
  post2MirrorSheetName  String?
  preMirrorSheetName    String?
  preDaysBefore         Int      @default(7)  // Pre-Training survey sent this many days before startDate
  post1DaysAfter        Int      @default(1)  // Post-1 survey sent this many days after endDate
  post2DaysAfter        Int      @default(30) // Post-2 survey sent this many days after endDate
  expiryEnabled         Boolean  @default(true) // whether an unfilled survey stops accepting responses after expiryDays
  expiryDays            Int      @default(7)    // days after the original send before an unfilled survey expires
  maxFileUploadMB       Int      @default(20)    // per-file cap for "file" question uploads — one of 5/10/20/50/100
  // Last mirror-append outcome per stage — JSON: { success: boolean, message: string, at: string }.
  // The submit route runs unauthenticated (public respondent-facing), so a mirror failure can't be
  // surfaced to whoever just filled the form — this makes it visible to the admin instead, since it
  // was previously only ever console.error'd server-side where nobody could see it.
  preMirrorStatus   String?
  post1MirrorStatus String?
  post2MirrorStatus String?
  // One shared mirror tab for EVERY Custom Survey (unlike the per-stage tabs above) — every
  // Custom Survey response appends here regardless of which survey it's for, using generic
  // Timestamp/Survey Name/Employee Name/Q1/Q2/... columns so responses from different surveys
  // (different questions) all land in the same sheet; Survey Name is what tells them apart.
  customSurveyMirrorSheetName String?
  customSurveyMirrorStatus    String?
  updatedAt             DateTime @updatedAt
}

// Admin-editable question set per survey stage — self-seeds with the agreed default questions
// the first time a stage is requested (same pattern as TrainingType/DifferentiatingCapability).
// fieldKey, when set, means this answer feeds a specific structured column on FeedbackRecord
// (post1) or ManagerReviewRecord (post2) — e.g. "confidenceRating", "impactScore". Questions
// without a fieldKey are still captured (in SurveyResponse.answers and the sheet mirror) but
// don't feed a dashboard metric. autoFill, when set, means the field is pre-populated from the
// training schedule/attendee record rather than asked (e.g. "trainingName", "employeeName").
model SurveyQuestion {
  id        String   @id @default(cuid())
  stage     String // "pre" | "post1" | "post2"
  order     Int
  section   String?
  label     String
  type      String // "text" | "textarea" | "select" | "multiselect" | "rating" | "date" | "yesno" | "file"
  options   String? // JSON array of strings — for select/multiselect
  required  Boolean  @default(false)
  autoFill  String?
  fieldKey  String?
  driveFolderId String? // for type "file" — the Google Drive folder the uploaded file is saved into
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, order])
}

// One row per submitted form — the full raw answer set (by question id), independent of
// whether individual answers also landed in a structured field elsewhere.
model SurveyResponse {
  id          String   @id @default(cuid())
  attendeeId  String
  stage       String
  answers     String // JSON: { [questionId]: string | string[] }
  submittedAt DateTime @default(now())

  // Per-response Google Sheet mirror outcome — null mirrorSyncedAt means either mirroring isn't
  // configured for this stage, or the last attempt failed (see mirrorError). Tracked per-response
  // (not just per-stage) so a specific failed submission can be retried without re-submitting the
  // form or double-creating its FeedbackRecord/ManagerReviewRecord.
  mirrorSyncedAt DateTime?
  mirrorError    String?

  attendee TrainingScheduleAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId, stage])
}

// Platform-wide SMTP config — admin-editable (not env vars), since email is used beyond just
// surveys. Single-row settings, same pattern as GoogleSheetsConfig/BudgetSettings. The password
// is stored as entered (no separate encryption layer beyond the DB's own security) and is never
// returned by the GET endpoint — only a "configured" flag — so it can't leak back to the client.
model SmtpSettings {
  id          String   @id @default(cuid())
  host        String?
  port        Int?
  username    String?
  password    String?
  fromName    String   @default("Meristem L&D")
  fromAddress String?
  updatedAt   DateTime @updatedAt
}

// Singleton, same pattern as SmtpSettings — read by every authenticated user (not just admins) so
// IdleLogout applies the configured timeout platform-wide, but only editable by an admin.
model SecuritySettings {
  id                 String   @id @default(cuid())
  idleTimeoutSeconds Int      @default(90)
  updatedAt          DateTime @updatedAt
}

// An "upcoming training" — distinct from TrainingRecord (actual cost, uploaded after the fact)
// so nothing double-counts. Drives the 3-stage survey email lifecycle for its attendees.
model TrainingSchedule {
  id              String   @id @default(cuid())
  trainingName    String
  businessUnit    String
  startDate       DateTime
  endDate         DateTime
  hours           Float?
  costPerAttendee Float? // applied uniformly to every attendee's mirrored Training Data row
  trainingType    String? // references TrainingType.name
  capability      String? // references DifferentiatingCapability.name
  vendor          String? // references Vendor.name — used by the TM Trainings report (training name, date, vendor)
  remindersEnabled Boolean @default(true) // daily reminder sweep skips this schedule entirely when false — defaults off for schedules created via "Already Attended Trainings" since those are retroactive, not on the original nomination cadence
  sourcedFromHistoricalData Boolean @default(false) // true when created via "Already Attended Trainings" (from already-uploaded Training Data records, not a fresh nomination) — Pre-Training is never sent for these, and Post-1/Post-2 copy adjusts accordingly
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendees TrainingScheduleAttendee[]
}

// One row per attendee on a schedule. Line-manager name/email are resolved from
// StaffRosterRecord at add-time and snapshotted here, so sending stays correct even if the
// roster changes later. sentAt timestamps double as "has this stage been sent" state.
model TrainingScheduleAttendee {
  id               String   @id @default(cuid())
  scheduleId       String
  staffId          String
  staffName        String
  email            String?
  lineManagerName  String?
  lineManagerEmail String?

  preSurveySentAt   DateTime?
  post1SurveySentAt DateTime?
  post2SurveySentAt DateTime?

  // Set when the attendee actually submits the form (distinct from *SentAt — response rate is
  // sent vs. responded, not sent vs. not-sent).
  preSurveyRespondedAt   DateTime?
  post1SurveyRespondedAt DateTime?
  post2SurveyRespondedAt DateTime?

  // Last reminder nudge (or the original send, whichever is later) — gates the reminder cron's
  // "was this person already nudged today" check (calendar-day comparison, since the cron itself
  // only runs once a day). *SurveySentAt itself stays fixed at the original send time (used for expiry).
  preReminderAt   DateTime?
  post1ReminderAt DateTime?
  post2ReminderAt DateTime?

  // Unguessable per-attendee link token — one token covers all 3 stages (/survey/{token}/pre
  // etc.), since only the person who received the email knows it.
  surveyToken String @unique @default(cuid())

  // Outcome of mirroring this attendee into the Training Data sheet (Admin -> Live Data Source ->
  // Training Cost tab) — null trainingDataSyncedAt means it hasn't been confirmed synced yet,
  // whether because it was never attempted, or the last attempt failed (see trainingDataSyncError).
  trainingDataSyncedAt DateTime?
  trainingDataSyncError String?

  // The TrainingRecord created alongside this attendee (same plain-string-reference convention as
  // staffId elsewhere in this schema, not a real FK) — lets removing this attendee also remove the
  // record it produced, instead of leaving a phantom row behind in Manage Records/analytics. Null
  // for attendees added before this linkage existed, or if that write failed.
  linkedTrainingRecordId String?

  createdAt DateTime @default(now())

  schedule  TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  // Prevents a retried/duplicate "add attendee" request (e.g. after a partial failure further
  // down the same request) from silently creating a second attendee row for the same person.
  @@unique([scheduleId, staffId])
  @@index([scheduleId])
  @@index([staffId])
}

model TrainingRecord {
  id           String   @id @default(cuid())
  serialNo     String?
  staffName    String
  staffId      String
  training     String
  businessUnit String
  month        String
  year         Int
  cost         Float
  hours        Float?   // Learning Hours (optional — populated when provided)
  trainingType String?  // References TrainingType.name — null = legacy row, treated as "Internal Training"
  capability   String?  // References DifferentiatingCapability.name
  vendor       String?  // Training vendor/facilitator — not part of the original upload columns, editable after the fact (e.g. from the Talent Members report for TM-tagged rows)
  batchId      String
  createdAt    DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
  @@index([year])
  @@index([staffId])
}

// A sync detected that an existing TrainingRecord's data disagrees with what the source sheet
// now says for what looks like the same event (same staff name + training + month, matched since
// Staff ID — the usual join key — is sometimes exactly the field being corrected). Held here for
// the admin to review old vs new and accept or reject, rather than silently overwritten, since the
// loose match could occasionally be a false positive (two different people, same name).
model TrainingRecordChange {
  id               String   @id @default(cuid())
  existingRecordId String
  oldData          String   // JSON snapshot of the current TrainingRecord's tracked fields
  newData          String   // JSON snapshot of what the sheet now says for the same fields
  changedFields    String   // JSON string[] of which fields actually differ
  detectedAt       DateTime @default(now())

  @@index([existingRecordId])
}

model FeedbackRecord {
  id                  String   @id @default(cuid())
  businessUnit        String
  trainingTitle       String
  role                String?
  applicationResponse String?
  impactAlignment     String?
  confidenceRating    Float?
  roleRelevance       Float?
  expectationsMet     Float?
  vendorRating        Float?   // Vendor/facilitator rating (0–5)
  vendorName          String?  // Vendor/facilitator name (free text)
  qualitativeResponse String?
  month               String?
  batchId             String
  createdAt           DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
}

model SubscriptionRecord {
  id             String   @id @default(cuid())
  month          String?
  staffId        String
  staffName      String
  businessUnit   String
  membershipOrg  String
  amount         Float
  batchId        String
  createdAt      DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
  @@index([membershipOrg])
  @@index([staffId])
}

// Knowledge Sharing Sessions (internal training hours)
model KSSRecord {
  id              String   @id @default(cuid())
  staffId         String
  staffName       String
  businessUnit    String
  durationMinutes Float    // In-Meeting Duration in minutes
  month           String?
  year            Int?
  batchId         String
  createdAt       DateTime @default(now())

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([businessUnit])
  @@index([staffId])
}

model HistoricalSnapshot {
  id        String   @id @default(cuid())
  period    String
  type      String
  data      String
  createdAt DateTime @default(now())

  @@unique([period, type])
}

model NarrativeReport {
  id        String   @id @default(cuid())
  period    String
  content   String
  type      String
  createdAt DateTime @default(now())
}

// Admin-created ad hoc survey — distinct from the Pre/Post-1/Post-2 training-lifecycle surveys
// above (which are tied to a TrainingSchedule attendee). A Custom Survey targets any slice of
// staff directly — everyone, one department, one role, one Business Unit, or a hand-picked list —
// and isn't about a specific training. Audience is resolved once, at launch, into concrete
// CustomSurveyRecipient rows (a snapshot) — adding someone to the target department after launch
// does not retroactively add them to an already-live survey; create a new one instead.
model CustomSurvey {
  id              String    @id @default(cuid())
  title           String
  description     String?
  audienceType    String    // "all" | "department" | "role" | "businessUnit" | "selected"
  audienceValue   String?   // department/role/BU name for those modes; JSON string[] of staff identifiers for "selected"; null for "all"
  expiryDays      Int       @default(14) // reminders sent once/day (same cadence as the training surveys) until filled or this many days after launch
  status          String    @default("draft") // "draft" (editable, not yet sent) | "launched" (recipients resolved + initial send done) | "closed" (reminders stopped)
  launchedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions  CustomSurveyQuestion[]
  recipients CustomSurveyRecipient[]
}

// Same type vocabulary as SurveyQuestion. No autoFill/fieldKey — a Custom Survey isn't tied to a
// training/attendee record to pull those values from, and its answers don't feed an existing
// structured metric (FeedbackRecord/ManagerReviewRecord); they're captured as-is.
model CustomSurveyQuestion {
  id            String   @id @default(cuid())
  surveyId      String
  order         Int
  section       String?
  label         String
  type          String   // "text" | "textarea" | "select" | "multiselect" | "rating" | "date" | "yesno" | "file"
  options       String?  // JSON array of strings — for select/multiselect
  required      Boolean  @default(false)
  driveFolderId String?  // for type "file"
  createdAt     DateTime @default(now())

  survey CustomSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, order])
}

// One row per targeted person, resolved from the roster at launch time — mirrors
// TrainingScheduleAttendee's pattern (own unguessable token, sent/responded/reminder timestamps).
model CustomSurveyRecipient {
  id           String    @id @default(cuid())
  surveyId     String
  staffId      String
  staffName    String
  email        String?
  businessUnit String?

  sentAt      DateTime?
  respondedAt DateTime?
  reminderAt  DateTime? // last reminder nudge (or the original send) — gates the daily reminder sweep's "already nudged today" check, same calendar-day comparison as the training surveys

  surveyToken String @unique @default(cuid())

  createdAt DateTime @default(now())

  survey    CustomSurvey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses CustomSurveyResponse[]

  @@unique([surveyId, staffId])
  @@index([surveyId])
}

model CustomSurveyResponse {
  id             String    @id @default(cuid())
  recipientId    String
  answers        String    // JSON: { [questionId]: string | string[] }
  submittedAt    DateTime  @default(now())
  mirrorSyncedAt DateTime?
  mirrorError    String?

  recipient CustomSurveyRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

// Monthly report snapshots — generated per BU per month
model MonthlyReport {
  id           String   @id @default(cuid())
  businessUnit String   // BU name, or "GROUP" for organisation-wide
  year         Int
  month        String
  reportData   String   // JSON snapshot of analytics at time of generation
  narrative    String   // Plain-text narrative
  generatedBy  String?
  generatedAt  DateTime @default(now())

  @@index([businessUnit])
  @@index([year, month])
  @@unique([businessUnit, year, month])
}
