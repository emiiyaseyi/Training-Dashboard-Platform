# ─── DATABASE ────────────────────────────────────────────────────────────────
# Production / Vercel — get a free PostgreSQL URL from Supabase (https://supabase.com)
# or Neon (https://neon.tech) or Railway (https://railway.app)
#
# DATABASE_URL — the POOLED connection string (Supabase: "Transaction" mode, port 6543,
# with ?pgbouncer=true). Used by the app at runtime. Serverless functions open a fresh
# connection per request, so this must go through a pooler, not a direct connection.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — the DIRECT connection string (Supabase: "Session"/direct, port 5432).
# Used only during build (prisma db push) to sync the schema — DDL operations don't
# work reliably through a transaction-mode pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Local development — copy this file to .env.local and use a local SQLite file instead
# (see prisma/schema.prisma — local dev runs on SQLite, only production uses Postgres)

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Session signing secret for NextAuth (Auth.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value in production than local dev — set it directly in Vercel's
# environment variables UI, never commit it.
AUTH_SECRET="generate-your-own-random-value"

# ─── GOOGLE SHEETS (optional live data source) ────────────────────────────────
# Create a Google Cloud Service Account, enable the Sheets API, generate a JSON key,
# then set these two values (share the target spreadsheet with the service account email
# as Viewer). The spreadsheet link and tab names themselves are configured in-app under
# Admin Settings, not here.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional — secures the /api/cron/sync-sheets endpoint that Vercel Cron calls on a schedule
# (see vercel.json). Vercel automatically sends this as a Bearer token to cron routes when set.
# Generate the same way as AUTH_SECRET. Safe to leave unset (the route just runs unauthenticated).
CRON_SECRET="generate-your-own-random-value"

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Learning Intelligence Dashboard"
