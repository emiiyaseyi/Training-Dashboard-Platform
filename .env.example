# ─── DATABASE ────────────────────────────────────────────────────────────────
# Production / Vercel — get a free PostgreSQL URL from Supabase (https://supabase.com)
# or Neon (https://neon.tech) or Railway (https://railway.app)
#
# DATABASE_URL — the POOLED connection string (Supabase: "Transaction" mode, port 6543,
# with ?pgbouncer=true). Used by the app at runtime. Serverless functions open a fresh
# connection per request, so this must go through a pooler, not a direct connection.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — the DIRECT connection string (Supabase: "Session"/direct, port 5432).
# Used only during build (prisma db push) to sync the schema — DDL operations don't
# work reliably through a transaction-mode pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Local development — copy this file to .env.local and use a local SQLite file instead
# (see prisma/schema.prisma — local dev runs on SQLite, only production uses Postgres)

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Learning Intelligence Dashboard"
